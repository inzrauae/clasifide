APP_NAME="4U.lk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Your domain. Use http:// until SSL (AutoSSL) is active, then switch to https:// (visitors are then redirected to https)
APP_URL=https://4u.lk
APP_TIMEZONE=Asia/Colombo

# Web root on the server. Leave empty: ~/public_html next to ~/4ulk is detected automatically
PUBLIC_PATH=

# One-time installer: open https://your-domain/install/THIS-KEY, then DELETE this value
INSTALL_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# cPanel: create the database + user in "MySQL Databases", then fill these in
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_4ulk
DB_USERNAME=cpaneluser_4ulk
DB_PASSWORD=

# File drivers work on any shared host
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# cPanel email account (Email Accounts > Connect Devices shows these settings)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.4u.lk
MAIL_PORT=465
MAIL_USERNAME=no-reply@4u.lk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@4u.lk"
MAIL_FROM_NAME="${APP_NAME}"

# --- 4U.lk settings ---
SUPPORT_EMAIL=hello@4u.lk
SUPPORT_PHONE="011 000 0000"
ADS_AUTO_APPROVE=true

# First admin account, created by `php artisan db:seed`
ADMIN_EMAIL=admin@4u.lk
ADMIN_PASSWORD=

# PayHere (https://www.payhere.lk) – Settings > Domains & Credentials
PAYHERE_ENABLED=false
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Bank transfer details shown at checkout
BANK_ACCOUNT_NAME="4U.lk (Pvt) Ltd"
BANK_NAME="Commercial Bank"
BANK_BRANCH="Colombo"
BANK_ACCOUNT_NO=0000000000

# Set to true once to load the sample ads on a production server
SEED_DEMO=false

# Google sign-in. Redirect URI must also be listed in the Google Cloud console.
GOOGLE_CLIENT_ID=809439970082-vdlf74ge2ctins7nhvnu5vt6kpq30c4f.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
